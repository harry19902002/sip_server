# Generate independent random values before starting the stack.
ESL_PASSWORD=replace-with-a-long-random-esl-password
FREESWITCH_API_KEY=replace-with-a-long-random-api-key
SIP_DEFAULT_PASSWORD=replace-with-a-strong-sip-password

# Initial web administrator. Change the password after the first login.
SYSTEM_ADMIN_USERNAME=admin
SYSTEM_ADMIN_PASSWORD=123456

# Immutable GitHub release tags used by the source-build image.
FREESWITCH_VERSION=1.11.2
SOFIA_SIP_VERSION=1.13.18
SPANDSP_VERSION=3.1.1
FREESWITCH_DOMAIN=sip.local

# For LAN SIP devices, set this to the host's reachable LAN IP.
# auto-nat is suitable only when FreeSWITCH can discover the correct address.
FREESWITCH_EXTERNAL_IP=auto-nat

SIP_PORT=5060
SIP_SERVER_HOST=127.0.0.1
RTP_PORT_START=16384
RTP_PORT_END=16484
FREESWITCH_API_PORT=3001
ESL_TIMEOUT_MS=5000

# Local prototype only. Keep false when exposing the API beyond 127.0.0.1.
ALLOW_INSECURE_BROWSER_API=true
